# ── Copy this file to .env and fill in your values ───────────
# .env is gitignored — never commit it

# Django secret key (generate a strong random one for production)
SECRET_KEY=django-insecure-change-this-to-something-random

# Admin credentials
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Set to true on Render (do NOT add this locally)
# RENDER=true
