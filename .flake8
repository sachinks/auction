[flake8]
max-line-length = 120
exclude =
    auction/migrations,
    __pycache__,
    .venv,
    .git
# Alignment / whitespace style (project uses column-aligned assignments)
# and other deliberate style choices — only real bugs are enforced.
ignore =
    E221,
    E241,
    E272,
    E251,
    E261,
    W291,
    W293,
    E231,
    E303,
    E226,
    W503,
    W504,
    E127
